  },
  "dependencies": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "electron": "36.3.1",
    "@playwright/test": "1.52.0"
  }
}
