{
  "appId": "local.agent.workbench",
  "productName": "Local Agent Workbench",
  "directories": {
    "output": "release"
  },
  "files": ["apps/desktop/**", "package.json"],
  "extraMetadata": {
    "main": "apps/desktop/main.cjs"
  },
  "extraResources": [
    {
      "from": "dist/web",
      "to": "dist/web"
    },
    {
      "from": "dist/backend",
      "to": "backend"
    }
  ],
  "win": {
    "target": "nsis",
    "signAndEditExecutable": false
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "allowElevation": false
  }
}
